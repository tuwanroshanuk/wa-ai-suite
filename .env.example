# ===== Postgres =====
POSTGRES_USER=wa_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=wa_suite

# ===== Backend / Dashboard auth =====
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_on_first_login
PUBLIC_API_URL=https://api.yourdomain.com
PUBLIC_APP_URL=https://app.yourdomain.com
# Comma-separated additional browser origins allowed to call the API/socket.
# Example for this deployment: https://typebot.nexuscloud.uk
CORS_ORIGINS=

# ===== Meta / WhatsApp Business Platform =====
# From Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# Any string you choose, must match what you type into Meta's webhook config
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change_me_verify_token
# App secret, used to validate X-Hub-Signature-256 on incoming webhooks
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

# ===== Gemini AI + caller transcription =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Optional separate model for short caller-audio transcription.
# Leave empty to use GEMINI_MODEL.
GEMINI_AUDIO_MODEL=
CALL_AI_ENABLED=true
CALL_AI_SYSTEM_PROMPT=You are a helpful, concise customer support voice assistant. Reply naturally in the caller's language. Keep each spoken response under three short sentences.

# Caller turn detection. Lower RMS catches quieter speech but can trigger on noise.
CALL_STT_RMS_THRESHOLD=420
CALL_STT_MIN_SPEECH_MS=700
CALL_STT_END_SILENCE_MS=850
CALL_STT_MAX_TURN_MS=12000
CALL_STT_PRE_ROLL_MS=250

# ===== Calling / WebRTC =====
AGENT_RING_TIMEOUT_MS=15000
WEBRTC_ICE_MIN_PORT=50000
WEBRTC_ICE_MAX_PORT=50010
WEBRTC_FAST_ICE_WAIT_MS=200
WEBRTC_AGENT_ICE_WAIT_MS=1200
WEBRTC_PUBLIC_IP=
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
CALL_GREETING=Hi! Thanks for calling. This is our AI assistant. How can I help?

# ===== TTS =====
# internal docker network URL, set automatically by docker-compose, override only if needed
TTS_SERVICE_URL=http://tts-service:6000
TTS_DEFAULT_VOICE=en-US-AriaNeural
# auto tries Edge neural TTS, then local espeak-ng if Edge returns 403.
TTS_PROVIDER=auto
TTS_ESPEAK_VOICE=en-us
TTS_ESPEAK_SPEED=165

# ===== Recordings =====
RECORDINGS_DIR=/app/recordings
