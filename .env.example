# ===== Postgres =====
POSTGRES_USER=wa_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=wa_suite

# ===== Backend / Dashboard auth =====
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_on_first_login
PUBLIC_API_URL=https://api.yourdomain.com
PUBLIC_APP_URL=https://app.yourdomain.com
# Comma-separated additional browser origins allowed to call the API/socket.
# Example for this deployment: https://typebot.nexuscloud.uk
CORS_ORIGINS=

# ===== Meta / WhatsApp Business Platform =====
# From Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# Any string you choose, must match what you type into Meta's webhook config
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change_me_verify_token
# App secret, used to validate X-Hub-Signature-256 on incoming webhooks
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

# ===== Gemini (free tier) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ===== TTS =====
# internal docker network URL, set automatically by docker-compose, override only if needed
TTS_SERVICE_URL=http://tts-service:6000
TTS_DEFAULT_VOICE=en-US-AriaNeural

# ===== Recordings =====
RECORDINGS_DIR=/app/recordings
