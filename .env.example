# ===== Postgres =====
POSTGRES_USER=wa_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=wa_suite

# ===== Backend / Dashboard auth =====
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_on_first_login
PUBLIC_API_URL=https://api.yourdomain.com
PUBLIC_APP_URL=https://app.yourdomain.com
CORS_ORIGINS=

# ===== Meta / WhatsApp Business Platform =====
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change_me_verify_token
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

# ===== Gemini AI =====
# Used by the text-response engine and Gemini 3.1 Flash Live voice sessions.
GEMINI_API_KEY=
# The dashboard AI Agent page stores the selected models in Postgres.
# These remain environment fallbacks for legacy message flows.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_AUDIO_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_CONNECT_TIMEOUT_MS=15000
GEMINI_LIVE_SETUP_TIMEOUT_MS=20000

# ===== Local caller transcription =====
# local = faster-whisper container, gemini = Gemini audio requests, auto = local then Gemini.
STT_PROVIDER=local
STT_SERVICE_URL=http://stt-service:7000
STT_MODEL=base
STT_CPU_THREADS=4
CALL_STT_RMS_THRESHOLD=420
CALL_STT_MIN_SPEECH_MS=700
CALL_STT_END_SILENCE_MS=850
CALL_STT_MAX_TURN_MS=12000
CALL_STT_PRE_ROLL_MS=250

# ===== Calling / WebRTC =====
AGENT_RING_TIMEOUT_MS=15000
WEBRTC_ICE_MIN_PORT=50000
WEBRTC_ICE_MAX_PORT=50010
WEBRTC_FAST_ICE_WAIT_MS=200
WEBRTC_AGENT_ICE_WAIT_MS=1200
WEBRTC_PUBLIC_IP=
WEBRTC_STUN_URL=stun:stun.l.google.com:19302

# ===== Local Piper neural TTS =====
TTS_SERVICE_URL=http://tts-service:6000
TTS_PROVIDER=piper
TTS_DEFAULT_VOICE=en_US-lessac-medium
TTS_DEFAULT_SPEED=1
TTS_ESPEAK_VOICE=en-us
TTS_ESPEAK_SPEED=165

# ===== Recordings =====
RECORDINGS_DIR=/app/recordings
